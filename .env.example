# ============================================================================
# 本地环境变量样例 —— 复制为 .env 后按需修改
# 严禁把真实密钥提交到 Git。本文件只允许出现占位符。
# ============================================================================

# ---------- 数据库 ----------
POSTGRES_USER=novel
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=novel
POSTGRES_PORT=5432

# Prisma 连接串。compose 内服务名为 postgres；本机直连用 127.0.0.1。
# 注意：密码部分必须与 POSTGRES_PASSWORD 完全一致，
# 否则 compose 配置校验会通过，但数据库实际连接失败。
DATABASE_URL="postgresql://novel:change-me-local-only@postgres:5432/novel?schema=public"

# ---------- 服务端口 ----------
WEB_PORT=3000
WORKER_PORT=3001
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443

# ---------- 模型服务（M1-A 阶段不接入真实模型，此处仅占位） ----------
# 说明：M1-A 阶段不接入任何真实模型 API，Key 仅为占位符，worker 不会调用模型。
MODEL_BASE_URL="http://localhost:11434/v1"
MODEL_NAME="placeholder-model"
MODEL_API_KEY="placeholder-not-a-real-key"

# ---------- 运行时 ----------
# 容器运行模式默认 production。
# 如需开发模式：叠加 infra/docker-compose.dev.yml（不改本默认值）。
NODE_ENV=production
LOG_LEVEL=info

# ---------- Compose 项目名（可选） ----------
# 默认 novel-platform；对应数据卷为 novel-platform_pgdata。
# 验证脚本会自动使用 novel-verify-<pid> 作为独立项目名，不会污染此卷。
COMPOSE_PROJECT_NAME=novel-platform

# ---------- 认证（M1-B1） ----------
# 初始管理员：只由 `pnpm admin:create` 一次性读取，不进入 Git、日志或数据库明文。
# 密码至少 12 个字符；创建后首次登录必须改密。
# 本文件只放占位符，真实值写在本地 .env（已被 .gitignore 忽略）。
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change-me-in-local-env-only

# 会话有效期
AUTH_SESSION_ABSOLUTE_HOURS=12
AUTH_SESSION_IDLE_MINUTES=30
# Cookie Secure：生产必须为 true；本地用 http 调试时才可设为 false
AUTH_COOKIE_SECURE=true
# 登录失败限流：窗口内最大失败次数 / 窗口分钟数
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_MINUTES=15
# 期望的站点来源（Origin 校验）。留空则按请求 URL 同源校验。
# 容器内经 Caddy 访问时应设为对外地址，例如 http://localhost:8080
APP_ORIGIN=
