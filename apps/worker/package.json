{
  "name": "@novel/worker",
  "version": "0.1.0",
  "private": true,
  "description": "后台任务 Worker：常驻轮询、chapter.draft 执行与健康检查（A1-3C）",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --build tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@novel/db": "workspace:*",
    "@novel/shared": "workspace:*",
    "@novel/workflow": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
