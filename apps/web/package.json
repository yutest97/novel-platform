{
  "name": "@novel/web",
  "version": "0.1.0",
  "private": true,
  "description": "Web 应用（Next.js）",
  "scripts": {
    "dev": "next dev --port ${WEB_PORT:-3000}",
    "build": "next build --webpack",
    "start": "next start --port ${WEB_PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@novel/auth": "workspace:*",
    "@novel/db": "workspace:*",
    "@novel/shared": "workspace:*",
    "@novel/works": "workspace:*",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
