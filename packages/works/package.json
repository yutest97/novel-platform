  "dependencies": {
    "@novel/auth": "workspace:*",
    "@novel/db": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.15.6",
    "pg": "8.16.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
