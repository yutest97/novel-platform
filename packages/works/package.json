{
  "name": "@novel/works",
  "version": "0.1.0",
  "private": true,
  "description": "小说作品核心：作品、题材规则包与作品设定（M2-A）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
