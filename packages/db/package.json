{
  "name": "@novel/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma 迁移框架与数据库连接（M1-A 阶段不含业务表）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "generate": "prisma generate",
    "migrate": "node scripts/require-database-url.mjs && prisma migrate dev",
    "migrate:deploy": "node scripts/require-database-url.mjs && prisma migrate deploy",
    "migrate:status": "node scripts/require-database-url.mjs && prisma migrate status",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@novel/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.9",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.6",
    "prisma": "7.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
