// Prisma schema —— M1 账号体系 + M2-A 作品核心。
//
// 表：users、sessions、audit_logs（账号体系）、
//     works、rule_packages、work_settings（作品核心）。
//
// 明确**不包含**章节、场景、人物、境界、势力、时间线、事实等业务表，
// 也不包含任何模型调用相关表 —— 那些属于后续阶段。
//
// 注意：Prisma 7 起 datasource 的连接串写在 prisma.config.ts 中（不在 schema 内）。
// 客户端产物输出到 src/generated/prisma（已在 .gitignore 中忽略，由 db:generate 生成）。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 账号角色。M1-B1 只有管理员与作者两种，权限骨架不做细粒度授权。
enum UserRole {
  admin
  author

  @@map("user_role")
}

/// 账号状态。disabled 表示停用：其所有会话必须立即失效。
enum UserStatus {
  active
  disabled

  @@map("user_status")
}

/// 账号。
///
/// - email 统一以小写形式存储（应用层规范化），unique 保证唯一。
/// - password_hash 只存 argon2id 哈希，绝不存明文或可逆密文。
/// - must_change_password 为 true 时，登录后只允许改密与退出。
model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String     @unique
  passwordHash       String     @map("password_hash")
  role               UserRole   @default(author)
  status             UserStatus @default(active)
  mustChangePassword Boolean    @default(true) @map("must_change_password")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions  Session[]
  auditLogs AuditLog[] @relation("AuditActor")
  works     Work[]    @relation("WorkAuthor")
  itemEvents ItemEvent[] @relation("ItemEventCreatedBy")
  chapterVersions ChapterVersion[] @relation("ChapterVersionCreatedBy")

  @@map("users")
}

/// 登录会话。
///
/// - 数据库只保存 token 的 SHA-256 哈希，不保存 token 本身。
/// - 同时具备绝对有效期（absolute_expires_at）与空闲有效期（idle_expires_at）。
/// - 每个账号最多 MAX_ACTIVE_SESSIONS 个活跃会话，超出时淘汰最旧会话。
model Session {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  tokenHash         String   @unique @map("token_hash")
  absoluteExpiresAt DateTime @map("absolute_expires_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime @map("idle_expires_at") @db.Timestamptz(3)
  lastActivityAt    DateTime @map("last_activity_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([idleExpiresAt])
  @@map("sessions")
}

/// 审计日志（append-only）。
///
/// 数据库层由触发器禁止 UPDATE / DELETE（见迁移 SQL），
/// 应用层只提供写入接口，不提供修改与删除接口。
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  detail     Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@index([actorId])
  @@map("audit_logs")
}

/// 题材规则包（M2-A）。
///
/// 只描述"某个题材允许哪些设定字段"，本身不含任何玄幻字段；
/// 玄幻相关的字段一律放在 work_settings 里，不进 works 的固定列。
model RulePackage {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  version     String
  active      Boolean  @default(true)
  fieldSchema Json     @map("field_schema")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  works Work[]

  @@map("rule_packages")
}

/// 小说作品（M2-A）。
///
/// - 归属作者：所有查询必须带 author_id 隔离；
/// - 同一作者下 title 唯一（不同作者可以有同名作品）；
/// - genre_rule_package 指向 rule_packages.code，且必须是 active 的；
/// - 本阶段**不含**章节/人物/境界等任何正文业务表。
model Work {
  id                    String   @id @default(uuid()) @db.Uuid
  authorId              String   @map("author_id") @db.Uuid
  title                 String
  genreRulePackage      String   @map("genre_rule_package")
  summary               String   @default("")
  targetChapters        Int      @default(10) @map("target_chapters")
  targetWordsPerChapter Int      @default(3000) @map("target_words_per_chapter")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  author   User          @relation("WorkAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  settings WorkSetting[]
  entities Entity[]
  itemEvents ItemEvent[]
  chapters Chapter[]
  generationTasks GenerationTask[]
  chapterContracts ChapterContract[]
  chapterCandidates ChapterCandidate[]
  chapterVersions ChapterVersion[]
  rulePack RulePackage  @relation(fields: [genreRulePackage], references: [code])

  @@unique([authorId, title])
  @@index([authorId, updatedAt])
  @@map("works")
}

/// 作品设定（M2-A）。
///
/// 结构化设定以 (setting_key, schema_ref) 定位，值放在 jsonb 里；
/// 题材差异通过 schema_ref 区分，**不**污染 works 的固定列。
model WorkSetting {
  id           String   @id @default(uuid()) @db.Uuid
  workId       String   @map("work_id") @db.Uuid
  settingKey   String   @map("setting_key")
  settingValue Json     @map("setting_value")
  schemaRef    String   @map("schema_ref")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([workId, settingKey, schemaRef])
  @@index([workId])
  @@map("work_settings")
}

/// 通用实体（M2-B1）。
///
/// - 只承载"实体"这一抽象骨架：具体的题材语义（境界、人物、功法……）
///   由 entity_type 区分，字段定义放在 rule_packages 的 field_schema 里；
/// - 删除是**软删除**（deleted_at）：同一作品同类型下未删除实体名称唯一，
///   软删除后同名可重新使用 —— 该约束由迁移里的**部分唯一索引**实现
///   （Prisma 不支持部分索引，因此这里只声明普通索引）；
/// - 查询必须带 work_id，跨作品不可见。
model Entity {
  id         String    @id @default(uuid()) @db.Uuid
  workId     String    @map("work_id") @db.Uuid
  entityType String    @map("entity_type")
  name       String
  orderIndex Int?      @map("order_index")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  work       Work              @relation(fields: [workId], references: [id], onDelete: Cascade)
  attributes EntityAttribute[]
  versions   EntityVersion[]
  itemEvents ItemEvent[]       @relation("ItemEventItem")
  itemEventsFrom ItemEvent[]   @relation("ItemEventFromHolder")
  itemEventsTo   ItemEvent[]   @relation("ItemEventToHolder")

  @@index([workId, entityType])
  @@map("entities")
}

/// 实体属性（M2-B1）。
///
/// 结构化属性以 (attr_key, schema_ref) 定位，值放在 jsonb 里；
/// schema_ref 指向规则包版本，便于将来按版本解释同一份数据。
model EntityAttribute {
  id           String   @id @default(uuid()) @db.Uuid
  entityId     String   @map("entity_id") @db.Uuid
  attrKey      String   @map("attr_key")
  attrValue    Json     @map("attr_value")
  schemaRef    String   @map("schema_ref")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, attrKey, schemaRef])
  @@index([entityId])
  @@map("entity_attributes")
}

/// 实体版本快照（M2-B1）。
///
/// 每次更新实体都追加一版快照，旧版本保留 —— 便于回溯与审计核对。
///
/// created_at 用 `clock_timestamp()`（数据库时钟，取值时刻即该行真正落库那一刻），
/// 而不是 `now()`（事务开始时刻）：实体写入会在事务里等锁，
/// 事务开始时刻可能远早于实际写入时刻。
/// 版本时间戳必须与 entities.deleted_at 同口径，
/// 否则"软删除之后不得再产生新版本"这条不变量无法被可靠观测。
model EntityVersion {
  id        String   @id @default(uuid()) @db.Uuid
  entityId  String   @map("entity_id") @db.Uuid
  versionNo Int      @map("version_no")
  snapshot  Json
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, versionNo])
  @@map("entity_versions")
}

/// 物品事件流水（M2-B3-B1）。
///
/// **物品持有人只有一个真相：本表的完整回放。**
/// `item` 规则包里没有 holder 字段，属性表也不存持有人，
/// 因此不存在"属性与流水不一致"的可能。
///
/// 回放口径：冲正行（reversal_of 非空）与其目标行**同时**从有效流里剔除，
/// 结果等价于"该冲正从未发生过"。冲正行的 from/to 只用于展示。
///
/// 只追加不修改：数据库触发器禁止 UPDATE / DELETE；
/// 录错靠追加冲正事件修正，不改历史行。
///
/// **不建 chapter_id**：chapters 表尚不存在，等该迁移落地时同批补列 + FK。
model ItemEvent {
  id             String   @id @default(uuid()) @db.Uuid
  workId         String   @map("work_id") @db.Uuid
  itemEntityId   String   @map("item_entity_id") @db.Uuid
  eventType      String   @map("event_type")
  /// 只由服务端按当前状态推导；接口层不接受客户端提交。
  fromHolder     String?  @map("from_holder") @db.Uuid
  toHolder       String?  @map("to_holder") @db.Uuid
  seqNo          Int      @map("seq_no")
  reversalOf     String?  @map("reversal_of") @db.Uuid
  idempotencyKey String   @map("idempotency_key")
  /// 剧情备注：只落库，不进审计、日志、URL 或 Web Storage。
  note           String?
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)

  work     Work   @relation(fields: [workId], references: [id], onDelete: Restrict)
  item     Entity @relation("ItemEventItem", fields: [itemEntityId], references: [id], onDelete: Restrict)
  fromHolderEntity Entity? @relation("ItemEventFromHolder", fields: [fromHolder], references: [id], onDelete: Restrict)
  toHolderEntity   Entity? @relation("ItemEventToHolder", fields: [toHolder], references: [id], onDelete: Restrict)
  createdByUser    User?   @relation("ItemEventCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  reversedTarget   ItemEvent?  @relation("ItemEventReversal", fields: [reversalOf], references: [id], onDelete: Restrict)
  reversal         ItemEvent?  @relation("ItemEventReversal")

  @@unique([itemEntityId, seqNo])
  @@unique([itemEntityId, idempotencyKey])
  @@unique([reversalOf])
  @@index([workId, itemEntityId, seqNo])
  @@map("item_events")
}

/// 章节（A1-1 最小骨架）。
///
/// 本阶段只建立表与隔离约束，不提供章节 UI / 生成 API；
/// status 沿用数据模型文档的六态枚举，默认 planned。
/// chapter_no 在**同一作品内**唯一且从 1 开始；不存卷号（卷纲属后续阶段）。
model Chapter {
  id        String   @id @default(uuid()) @db.Uuid
  workId    String   @map("work_id") @db.Uuid
  chapterNo Int      @map("chapter_no")
  title     String
  status    String   @default("planned")
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  work            Work             @relation(fields: [workId], references: [id], onDelete: Restrict)
  generationTasks GenerationTask[]
  contracts       ChapterContract[]
  candidates      ChapterCandidate[]
  versions        ChapterVersion[]

  @@unique([workId, chapterNo])
  /// 供 chapter_contracts / chapter_candidates 的复合外键引用
  @@unique([id, workId])
  @@index([workId, chapterNo])
  @@map("chapters")
}

/// 生成任务（A1-1 工作流内核）。
///
/// - `(work_id, request_id)` 唯一：同一逻辑请求只创建一个任务；
/// - `input_hash` 是 request_id 背后内容的 SHA-256 指纹：同键同指纹返回既有行，
///   同键异指纹稳定报 TASK_REQUEST_CONFLICT（不覆盖、不新建）；
/// - status 只允许 queued → processing → succeeded/failed/cancelled，
///   processing 可回到 queued（重试）；迁移合法性与"终态不可变"
///   由数据库触发器兜底；
/// - 租约（locked_by/lease_until）用于崩溃恢复：租约过期后由 sweep 重新排队，
///   详见 docs/08-workflow-and-agents.md；
/// - input_snapshot 只放结构化输入（不含 prompt/正文/密钥）；
/// - error_message_sanitized 只存服务端映射后的安全文案，永不存模型原始错误。
model GenerationTask {
  id                    String    @id @default(uuid()) @db.Uuid
  workId                String    @map("work_id") @db.Uuid
  chapterId             String?   @map("chapter_id") @db.Uuid
  requestId             String    @map("request_id")
  /// SHA-256(hex)，64 位；不含正文 / prompt / 密钥
  inputHash             String    @map("input_hash")
  taskType              String    @map("task_type")
  status                String    @default("queued")
  currentStep           String?   @map("current_step")
  inputSnapshot         Json      @map("input_snapshot")
  provider              String
  model                 String
  attemptCount          Int       @default(0) @map("attempt_count")
  maxAttempts           Int       @default(3) @map("max_attempts")
  lockedBy              String?   @map("locked_by")
  leaseUntil            DateTime? @map("lease_until") @db.Timestamptz(3)
  heartbeatAt           DateTime? @map("heartbeat_at") @db.Timestamptz(3)
  cancelRequestedAt     DateTime? @map("cancel_requested_at") @db.Timestamptz(3)
  errorCode             String?   @map("error_code")
  errorMessageSanitized String?   @map("error_message_sanitized")
  createdAt             DateTime  @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  work       Work        @relation(fields: [workId], references: [id], onDelete: Restrict)
  chapter    Chapter?    @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  contexts   TaskContext[]
  llmLogs    LlmCallLog[]
  chapterContract ChapterContract?
  chapterCandidate ChapterCandidate?

  @@unique([workId, requestId])
  /// 供 chapter_contracts / chapter_candidates 的复合外键引用
  @@unique([id, chapterId, workId])
  @@index([workId, status, createdAt])
  @@index([status, createdAt])
  @@index([status, leaseUntil])
  @@map("generation_tasks")
}

/// 任务上下文引用（A1-1）。
///
/// 只保存"引用了什么 + 简短摘要"，**不保存正文**；
/// snippet 由调用方裁剪，长度 ≤ 500。
model TaskContext {
  id          String  @id @default(uuid()) @db.Uuid
  taskId      String  @map("task_id") @db.Uuid
  contextType String  @map("context_type")
  refId       String? @map("ref_id") @db.Uuid
  snippet     String?
  rank        Int     @default(0)

  task GenerationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, contextType, refId])
  @@index([taskId, rank])
  @@map("task_contexts")
}

/// 模型调用日志（A1-1）。
///
/// 只记可计量字段：**不保存 prompt、不保存响应正文、不保存 API Key**；
/// 失败只记稳定的 error_code（不记模型原始错误，避免带出请求内容）。
model LlmCallLog {
  id               String   @id @default(uuid()) @db.Uuid
  taskId           String   @map("task_id") @db.Uuid
  stage            String
  provider         String
  model            String
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  latencyMs        Int      @default(0) @map("latency_ms")
  success          Boolean
  errorCode        String?  @map("error_code")
  createdAt        DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)

  task GenerationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([createdAt])
  @@map("llm_call_logs")
}

/// 章节合同（A1-2）。
///
/// - 由 Planner Agent 输出、工作流代码校验后**冻结**；冻结后不修改；
/// - 每个 generation_task 最多一份合同（重试复用）；
/// - 同一章节按 version_no 递增（UNIQUE(chapter_id, version_no)）；
/// - scene_beats 同时承载人物名单与场景节拍：
///   `{ version, characters: string[], scenes: [...] }`；
/// - 计划内容不写入审计，审计只记 ids / version / targetWords。
model ChapterContract {
  id               String   @id @default(uuid()) @db.Uuid
  workId           String   @map("work_id") @db.Uuid
  chapterId        String   @map("chapter_id") @db.Uuid
  generationTaskId String   @map("generation_task_id") @db.Uuid
  versionNo        Int      @map("version_no")
  goal             String
  mustInclude      Json     @map("must_include")
  mustNotInclude   Json     @map("must_not_include")
  sceneBeats       Json     @map("scene_beats")
  targetWords      Int      @map("target_words")
  status           String   @default("frozen")
  createdAt        DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)

  work       Work           @relation(fields: [workId], references: [id], onDelete: Restrict)
  chapter    Chapter        @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  task       GenerationTask @relation(fields: [generationTaskId], references: [id], onDelete: Restrict)
  candidates ChapterCandidate[]

  @@unique([chapterId, versionNo])
  @@unique([generationTaskId])
  @@index([chapterId, versionNo])
  @@map("chapter_contracts")
}

/// 章节正文候选（A1-2）。
///
/// - 只是候选，不是正式正文；采纳与 chapter_versions 属于 A1-3；
/// - 每个 generation_task 最多一条（重试复用）；
/// - word_count 由服务端按"非空白字符数"统计，不信任模型返回值；
/// - structured_plan 只存计划（goal / scenes / characters / targetWords），
///   不含 prompt 或模型原始响应。
model ChapterCandidate {
  id               String   @id @default(uuid()) @db.Uuid
  workId           String   @map("work_id") @db.Uuid
  chapterId        String   @map("chapter_id") @db.Uuid
  generationTaskId String   @map("generation_task_id") @db.Uuid
  contractId       String   @map("contract_id") @db.Uuid
  content          String
  wordCount        Int      @map("word_count")
  structuredPlan   Json     @map("structured_plan")
  status           String   @default("candidate")
  createdAt        DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)

  work     Work            @relation(fields: [workId], references: [id], onDelete: Restrict)
  chapter  Chapter         @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  task     GenerationTask  @relation(fields: [generationTaskId], references: [id], onDelete: Restrict)
  contract ChapterContract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  /// 该候选生成的正式版本（数据库部分唯一索引保证最多一条）
  sourceVersion ChapterVersion? @relation("ChapterVersionSource")

  @@unique([generationTaskId])
  /// 供 chapter_versions 的复合外键引用（来源候选必须同章节同作品）
  @@unique([id, chapterId, workId])
  @@index([chapterId, createdAt])
  @@map("chapter_candidates")
}

/// 正式章节版本（A1-3A）。
///
/// - 这是**正式正文**，append-only：数据库触发器拒绝 UPDATE / DELETE，
///   修订只能追加新版本；
/// - `UNIQUE(chapter_id, version_no)`；`source_candidate_id` 部分唯一
///   （一个候选最多生成一个正式版本）；
/// - `source = ai` 时 `source_candidate_id` 必填；`human` 留给 A1-B；
/// - `parent_version_id` 指向同章节同作品的上一个正式版本（首版为 NULL）；
/// - 归属由复合外键保证：章节属于作品，来源候选与父版本必须同章节同作品。
model ChapterVersion {
  id                String   @id @default(uuid()) @db.Uuid
  workId            String   @map("work_id") @db.Uuid
  chapterId         String   @map("chapter_id") @db.Uuid
  versionNo         Int      @map("version_no")
  content           String
  wordCount         Int      @map("word_count")
  /// ai | human
  source            String
  sourceCandidateId String?  @map("source_candidate_id") @db.Uuid
  parentVersionId   String?  @map("parent_version_id") @db.Uuid
  createdBy         String   @map("created_by") @db.Uuid
  createdAt         DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)

  work            Work             @relation(fields: [workId], references: [id], onDelete: Restrict)
  chapter         Chapter          @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  creator         User             @relation("ChapterVersionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  sourceCandidate ChapterCandidate? @relation("ChapterVersionSource", fields: [sourceCandidateId], references: [id], onDelete: Restrict)
  parent          ChapterVersion?   @relation("ChapterVersionParent", fields: [parentVersionId], references: [id], onDelete: Restrict)
  children        ChapterVersion[]  @relation("ChapterVersionParent")

  @@unique([chapterId, versionNo])
  @@unique([sourceCandidateId])
  /// 供子版本 / 兄弟版本的复合外键引用
  @@unique([id, chapterId, workId])
  @@index([chapterId, versionNo])
  @@map("chapter_versions")
}

/// 章节连续性事实提取运行（A2-A）。
///
/// - `UNIQUE(source_version_id)`：一个正式版本最多一次提取（幂等 / 并发兜底）；
/// - `(id, sourceVersionId, chapterId, workId)` 唯一：让候选的 run 外键可以是
///   复合外键，从而在数据库层保证「候选与 run 属于同一作品 / 章节 / 版本」；
/// - `startedAt` 是本次尝试的开始时间，同时充当 running 租约的起点；
/// - `attemptToken` 是本次尝试的身份（fencing token）：新建时由数据库生成，
///   每次 failed → running 必须轮换；成功写入与失败标记都以它做 CAS，
///   旧 attempt 即使晚返回也不能提交或改写新 attempt；
/// - 只允许受控状态更新（running → succeeded / failed，failed → running），
///   成功后不可再改；DELETE 由触发器拒绝；
/// - 正文不进入本表：只记录 agent / provider / model 与状态。
model ChapterFactRun {
  id              String    @id @default(uuid()) @db.Uuid
  workId          String    @map("work_id") @db.Uuid
  chapterId       String    @map("chapter_id") @db.Uuid
  sourceVersionId String    @map("source_version_id") @db.Uuid
  agentName       String    @map("agent_name")
  agentVersion    String    @map("agent_version")
  provider        String
  model           String
  status          String
  errorCode       String?   @map("error_code")
  createdAt       DateTime  @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)
  startedAt       DateTime  @default(dbgenerated("clock_timestamp()")) @map("started_at") @db.Timestamptz(3)
  attemptToken    String    @default(dbgenerated("gen_random_uuid()")) @map("attempt_token") @db.Uuid
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(3)

  candidates ChapterFactCandidate[]

  @@unique([sourceVersionId])
  @@unique([id, sourceVersionId, chapterId, workId])
  @@index([chapterId, createdAt])
  @@map("chapter_fact_runs")
}

/// 章节连续性事实候选（A2-A）。
///
/// append-only：UPDATE / DELETE 由触发器拒绝；`status` 只允许 `candidate`。
/// `payload` 是结构化事实（不含正文、prompt、模型原始响应）。
/// run 外键是**复合外键**：候选的 work / chapter / version 必须与 run 一致。
model ChapterFactCandidate {
  id              String   @id @default(uuid()) @db.Uuid
  runId           String   @map("run_id") @db.Uuid
  workId          String   @map("work_id") @db.Uuid
  chapterId       String   @map("chapter_id") @db.Uuid
  sourceVersionId String   @map("source_version_id") @db.Uuid
  factType        String   @map("fact_type")
  payload         Json
  status          String   @default("candidate")
  createdAt       DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)

  run ChapterFactRun @relation(fields: [runId, sourceVersionId, chapterId, workId], references: [id, sourceVersionId, chapterId, workId], onDelete: Restrict)

  @@index([runId])
  @@index([chapterId, factType])
  @@map("chapter_fact_candidates")
}
