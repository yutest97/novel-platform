{
  "name": "@novel/workflow",
  "version": "0.1.0",
  "private": true,
  "description": "确定性工作流内核、模型 Provider、Agent 运行基础设施、PostgreSQL 任务队列与单章候选流水线（A1-1 / A1-2）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@novel/auth": "workspace:*",
    "@novel/db": "workspace:*",
    "@novel/works": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.15.6",
    "pg": "8.16.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
