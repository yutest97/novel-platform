# Caddy 本地开发配置
#
# 重要：本文件仅用于**本地开发**。
# - 使用 `tls internal` 生成自签证书，不向 Let's Encrypt 申请公网证书。
# - 仅监听 80/443，由 compose 绑定到宿主机回环地址 8080/8443。
# - 不做任何公网部署配置。
{
	admin off
	auto_https off
}

:80 {
	# /healthz 路由到 web 应用
	handle /api/healthz* {
		reverse_proxy web:3000
	}

	# worker 健康检查：handle_path 会剥离路径前缀，
	# 转发到 worker 时变为 /healthz（worker 自身的健康路径）。
	handle_path /worker/* {
		reverse_proxy worker:3001
	}

	# 其余请求代理到 web 应用
	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}

:443 {
	tls internal

	handle /api/healthz* {
		reverse_proxy web:3000
	}

	handle_path /worker/* {
		reverse_proxy worker:3001
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}
