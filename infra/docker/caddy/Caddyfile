# Caddy 本地开发配置
#
# 重要：本文件仅用于**本地开发**。
# - 使用 `tls internal` 生成自签证书，不向 Let's Encrypt 申请公网证书。
# - 仅监听 80/443，由 compose 绑定到宿主机回环地址 8080/8443。
# - 不做任何公网部署配置。
#
# HTTPS 站点必须写**明确主机名**（TLS-FIX-01）：
# 只写 `:443` 时没有可用于签发/选择证书的站点名，握手会失败并返回
# `tlsv1 alert internal error`（curl 35）。因此写作 `https://localhost:443`：
#   - 端口 443 是**容器内**监听端口，由 compose 映射为宿主机 8443；
#   - 主机名 localhost 用于签发 internal 证书与匹配请求 Host（Caddy 匹配时忽略端口）。
#
# 全局选项用 `auto_https disable_redirects`，**不能**用 `auto_https off`：
# `off` 会把证书自动化一并关闭，导致 `tls internal` 也不签发叶子证书，
# 握手仍然报 internal error。`disable_redirects` 只关掉 80→443 的自动跳转，
# 保留证书签发，因此 :80 的健康检查入口可以继续工作（不会被 308 到 https）。
#
# 客户端 IP 传递（REV-01）：
# - `header_up X-Real-IP {remote_host}`：由 Caddy 写入**真实**对端地址，
#   并覆盖客户端自带的同名头。应用只信任这一个头（见 packages/auth/src/origin.ts）。
# - `header_up X-Forwarded-For {remote_host}`：覆盖而非追加，
#   避免客户端伪造的 XFF 列表被继续往下传。
# - 应用**不读取** X-Forwarded-For，因此伪造该头无法绕过按 IP 的登录限流。
{
	admin off
	auto_https disable_redirects
}

:80 {
	# /healthz 路由到 web 应用
	handle /api/healthz* {
		reverse_proxy web:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
		}
	}

	# worker 健康检查：handle_path 会剥离路径前缀，
	# 转发到 worker 时变为 /healthz（worker 自身的健康路径）。
	handle_path /worker/* {
		reverse_proxy worker:3001 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
		}
	}

	# 其余请求代理到 web 应用
	handle {
		reverse_proxy web:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
		}
	}

	log {
		output stdout
		format console
	}
}

https://localhost:443 {
	tls internal

	handle /api/healthz* {
		reverse_proxy web:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle_path /worker/* {
		reverse_proxy worker:3001 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle {
		reverse_proxy web:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
		}
	}

	log {
		output stdout
		format console
	}
}
